{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/finance/**",
              "components/forms/**",
              "uploads/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:DM Sans|JetBrains Mono|IBM Plex Sans Arabic))/i]",
        "message": "Font not provided by the design system. Available: DM Sans, JetBrains Mono, IBM Plex Sans Arabic."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='BudgetRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:percent|size|stroke|label|color|key|ref|className|style|children)$/]",
        "message": "<BudgetRing> doesn't accept that prop. Declared props: percent, size, stroke, label, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|startIcon|endIcon|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, startIcon, endIcon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|interactive|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, interactive."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExpenseRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|iconBg|iconColor|description|category|amount|currency|method|key|ref|className|style|children)$/]",
        "message": "<ExpenseRow> doesn't accept that prop. Declared props: icon, iconBg, iconColor, description, category, amount, currency, method."
      },
      {
        "selector": "JSXOpeningElement[name.name='KPICard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|value|icon|tone|trend|trendLabel|onClick|className|key|ref|className|style|children)$/]",
        "message": "<KPICard> doesn't accept that prop. Declared props: title, value, icon, tone, trend, trendLabel, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyDisplay'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|currency|tone|size|secondary|key|ref|className|style|children)$/]",
        "message": "<MoneyDisplay> doesn't accept that prop. Declared props: amount, currency, tone, size, secondary."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|tone|height|key|ref|className|style|children)$/]",
        "message": "<Progress> doesn't accept that prop. Declared props: value, tone, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|checked|defaultChecked|onCheckedChange|disabled|className|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: size, checked, defaultChecked, onCheckedChange, disabled, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Badge": {
        "replaces": []
      },
      "BudgetRing": {
        "replaces": []
      },
      "Button": {
