{
  "name": "buddget",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "generate-icons": "node scripts/generate-pwa-icons.mjs",
    "test": "TZ=${TZ:-Africa/Cairo} vitest run",
    "test:coverage": "TZ=${TZ:-Africa/Cairo} vitest run --coverage",
    "test:watch": "vitest",
    "cap:env:check": "node scripts/native-env.mjs check",
    "cap:build": "node scripts/capacitor-build.mjs",
    "cap:android": "npm run cap:build && npx cap open android",
    "cap:ios": "npm run cap:build && npx cap open ios",
    "cap:sync": "npx cap sync",
    "postinstall": "node scripts/patch-android-plugins.mjs",
    "eval:ai": "RUN_AI_EVAL=1 vitest run src/lib/ai/buddgy.eval.test.ts",
    "test:pg": "bash scripts/qa/setup.sh && QA_PG_URL=${QA_PG_URL:-postgres://postgres@localhost:54329/qa} vitest run --reporter=verbose .pg.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@base-ui/react": "^1.3.0",
    "@capacitor-firebase/messaging": "^8.2.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.3.26",
    "@sentry/capacitor": "4.4.0",
    "@sentry/react": "10.69.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.38.0",
    "groq-sdk": "^1.2.0",
    "lucide-react": "^0.577.0",
    "next": "^16.3.5",
    "next-pwa": "^5.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/next-pwa": "^5.6.9",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "pg": "^8.23.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
